# Gemini API key. Create one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-key-here

# Model id used for chat. Verify with `npm run check:model` before changing.
GEMINI_MODEL=gemini-3.5-flash-lite

# Local Postgres. Create the database with `createdb sales_ai`.
DATABASE_URL=postgresql://localhost:5432/sales_ai

# Pepper for session tokens. Generate with: openssl rand -base64 32
# Changing it signs everyone out, which is the intended emergency lever.
AUTH_SECRET=

# Public origin. Used to build the OAuth redirect URIs below.
APP_URL=http://localhost:3000

# Web search (Serper.dev). Without this the searchWeb and fetchPage research
# path is unavailable and the assistant will say so.
SEARCH_API_KEY=

# Apollo.io B2B database. Optional: when absent, the Apollo tools are not
# registered at all and the assistant falls back to web research.
APOLLO_API_KEY=

# Which transport delivers mail.
#   auto  - use SMTP when it is configured, otherwise the Gmail connection
#   smtp  - force SMTP
#   gmail - force the Gmail OAuth connection
EMAIL_TRANSPORT=auto

# SMTP. The simplest option: no consent screen, just credentials. All three of
# HOST, USER and PASS must be set or the config is treated as absent.
# For Gmail SMTP use smtp.gmail.com:587 with an App Password (not your normal
# password), which requires 2-Step Verification on the account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to SMTP_USER. Implicit TLS is assumed on port 465.
SMTP_FROM=
SMTP_SECURE=false

# One Google OAuth client serves two separate flows:
#   - "Sign in with Google" on the login page (profile + email only)
#   - "Connect Google" in Settings, for sending mail (gmail.send)
# Create the client at https://console.cloud.google.com and register BOTH
# redirect URIs below as authorized redirects. Leaving the client id blank
# hides the Google sign-in button; email and password still work.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Sending consent (gmail.send).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Sign-in consent (no send scope).
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Outbound email guard. Enforced in one place, in lib/mailer.ts above both
# transports, so nothing can route around it.
#   none - draft and log only, nothing is delivered (default, and the default
#          when the value is missing or invalid)
#   test - deliver every message to TEST_EMAIL_RECIPIENT instead of the real
#          address, with the real recipient kept in the subject line
#   send - deliver to real recipients
SEND_EMAIL=none
TEST_EMAIL_RECIPIENT=variyakishita@gmail.com
